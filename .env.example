# Hermes Memory Configuration
# Copy to .env and fill in your keys. Only set the providers you want to use.

# ===== L2 Episode Auto-Summary (v2.3+) =====
# Provider priority: HERMES_LLM_PROVIDER (explicit) > HERMES_LLM_BASE_URL (custom)
#   > opencode CLI (free, auto if opencode.exe on PATH) > API-key providers.

# --- Option A: OpenCode free model (zero cost, zero key) ---
# Auto-selected when opencode.exe is found on PATH. Force it with:
# HERMES_LLM_PROVIDER=opencode
# OPENCODE_MODEL=opencode/mimo-v2.6-flash-free
# OPENCODE_BIN=C:\path\to\opencode.exe   # only if not on PATH

# --- Option B: any OpenAI-compatible endpoint ---
# HERMES_LLM_BASE_URL=http://127.0.0.1:8899
# HERMES_LLM_API_KEY=sk-...
# HERMES_LLM_MODEL=default

# --- Option C: hosted providers (set the key you have) ---
# DeepSeek (recommended, ~¥1 / 1M tokens)
DEEPSEEK_API_KEY=your-d-key-here
# SiliconFlow (¥14 starter pack, Chinese-optimized)
SILICONFLOW_API_KEY=your-s-key-here
# OpenRouter (free tier available)
OPENROUTER_API_KEY=your-o-key-here
# Groq (fast inference, free tier)
GROQ_API_KEY=your-g-key-here
# Force a specific provider (overrides everything above)
# HERMES_LLM_PROVIDER=deepseek

# ===== Data Path =====
# HERMES_MEMORY_HOME=~/.hermes-memory

# ===== Dashboard =====
# HERMES_MEMORY_PORT=3211
# HERMES_MEMORY_HOST=127.0.0.1